include CHANGELOG.md
include README.en.md
recursive-include configs *.json *.yaml *.inp
recursive-include docs *.md *.json *.png
# Dated reports are preserved as repository history; packages ship current guides.
recursive-exclude docs/verification *.md
prune docs/superpowers
prune docs/research
recursive-include examples *.py *.md *.json *.yaml *.csv *.txt *.inp
recursive-include tests *.py *.csv *.json
recursive-include scripts *.py
include .github/workflows/tests.yml
